# Copia este archivo como .env para desarrollo local.
# En Render, define estas mismas claves en el dashboard del servicio (Environment), nunca en el repo.

# --- Obligatorias: el servidor no arranca sin ellas ---
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/bellaBeauty?retryWrites=true&w=majority
JWT_SECRET=defineUnaCadenaLargaYAleatoriaAqui

# --- Opcionales: cada una habilita una función concreta ---
PORT=5000
NODE_ENV=development

# URL pública del frontend (se usa en el enlace de recuperación de contraseña)
FRONTEND_URL=https://tu-dominio-en-render.onrender.com

# Correo por HTTPS (recomendado para Render Free, que bloquea SMTP).
# Crea la clave en Resend y guárdala únicamente en Render > Environment.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Dirección de un dominio verificado en Resend.
EMAIL_FROM="Bella Beauty <contacto@tu-dominio.com>"
# Bandeja que recibirá los mensajes del formulario.
CONTACT_EMAIL=tu-correo@gmail.com

# Alternativa para instalaciones con SMTP disponible: EMAIL_PROVIDER=smtp.
# Sin EMAIL_PROVIDER, se usa Resend si existe RESEND_API_KEY; de lo contrario Gmail.
# EMAIL_USER también sirve de destino si no defines CONTACT_EMAIL.
# EMAIL_PASS debe ser una contraseña de aplicación de Gmail.
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (imágenes de perfil, productos y galería)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
